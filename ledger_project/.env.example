# Copy to .env for local development. On Railway, set these as service
# variables instead — this file is only read locally (see settings.py).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset locally to fall back to SQLite. On Railway this is provided
# automatically once you attach a Postgres database.
# DATABASE_URL=postgres://user:password@host:port/dbname
